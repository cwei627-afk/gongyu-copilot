# Copy to .env.demo.local; never commit local credentials.
DIFY_BASE_URL=http://localhost
# Example only: must match the existing project shown by docker compose ls.
DIFY_COMPOSE_PROJECT=dify
DIFY_COMPOSE_DIR=
DOCKER_DESKTOP_EXE=
# Optional existing executable/model directory; leave blank when Ollama is on PATH.
OLLAMA_EXE=
OLLAMA_MODELS=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Obtain each key from its own published app. IDs are instance-specific.
DIFY_C_APP_ID=
DIFY_D_APP_ID=
DIFY_E1_APP_ID=
DIFY_C_API_KEY=
DIFY_D_API_KEY=
DIFY_E1_API_KEY=
DIFY_DATASET_ID=
DIFY_KNOWLEDGE_API_KEY=
# Must match the Dify Agent secret; generated once if no existing .env.stage-d.
AGENT_CONTROL_SECRET=
