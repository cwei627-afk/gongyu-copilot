# Host interface exposed by the FastAPI container. Dify on this host calls
# http://host.docker.internal:18086 by default.
API_BIND_ADDRESS=0.0.0.0
API_PORT=18086

# Local audit/model credentials: never commit the actual value.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=high
