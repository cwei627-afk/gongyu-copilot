{
  "openapi": "3.0.3",
  "info": {
    "title": "Stage D bounded read-only tools",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://host.docker.internal:18090"
    }
  ],
  "paths": {
    "/agent/tools/mes_heat/{entity_id}": {
      "get": {
        "operationId": "mes_heat",
        "summary": "查询 MES 炉次基础信息",
        "description": "查询用户明确输入的炉次身份、钢种及当前源状态。炉次入口必须首先调用本工具。200不是工艺判定。不得补数据。 仅GET，只读。capability由Workflow手动变量绑定，不由模型生成。返回status=verified/facts/verified_claims/output_schema；任何其他status立即停止。原源404/409/422/5xx语义保留在code/category；工具HTTP200不等于业务成功。禁止PLC、写操作、SQL、URL和正式工艺判断。",
        "parameters": [
          {
            "name": "entity_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "description": "用户明确ID或本次上游已验证关系返回ID；不得构造"
          },
          {
            "name": "capability",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Workflow绑定的请求级只读能力；必须设置auto=0/variable，不交给模型"
          }
        ],
        "responses": {
          "200": {
            "description": "请检查status：verified才有已验证facts；失败清空事实/来源，后续调用关闭。",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "verified"
                          ]
                        },
                        "facts": {
                          "$ref": "#/components/schemas/Heat"
                        },
                        "verified_claims": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "claim_id": {
                                "type": "string"
                              },
                              "text": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "claim_id",
                              "text"
                            ]
                          }
                        },
                        "output_schema": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "status",
                        "facts",
                        "verified_claims",
                        "output_schema"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/AgentToolFailure"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "请求能力无效/过期；不是工艺异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentToolFailure"
                }
              }
            }
          },
          "422": {
            "description": "request / INVALID_PARAMETER：路径参数格式非法，未查询业务系统。",
            "content": {
              "application/json": {
                "examples": {
                  "invalid_parameter": {
                    "value": {
                      "error": {
                        "category": "request",
                        "code": "INVALID_PARAMETER",
                        "message": "请求参数格式非法",
                        "fields": [
                          "path.heat_id"
                        ]
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "system / INTERNAL_ERROR：内部系统失败，事实状态未知，不得推断生产异常。",
            "content": {
              "application/json": {
                "examples": {
                  "internal_error": {
                    "value": {
                      "error": {
                        "category": "system",
                        "code": "INTERNAL_ERROR",
                        "message": "内部系统失败，事实状态未知",
                        "fields": []
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/agent/tools/mes_links/{entity_id}": {
