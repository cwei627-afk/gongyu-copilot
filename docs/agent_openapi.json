  "components": {
    "schemas": {
      "AnalysisContext": {
        "properties": {
          "heat": {
            "$ref": "#/components/schemas/Heat",
            "description": "MES 炉次基础事实"
          },
          "process_stage": {
            "type": "string",
            "minLength": 1,
            "title": "Process Stage",
            "description": "MES 当前工艺阶段"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "title": "Scope",
            "description": "MES 当前产线"
          },
          "stage_started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Stage Started At",
            "description": "当前阶段开始时刻；拒绝沿用之前阶段的测量"
          },
          "temperature": {
            "$ref": "#/components/schemas/Temperature",
            "description": "MES 保存的温度实测记录"
          },
          "chemistry": {
            "$ref": "#/components/schemas/Chemistry",
            "description": "MES 保存的成分实测记录"
          },
          "rule": {
            "$ref": "#/components/schemas/ProcessRule",
            "description": "匹配当前钢种、阶段、状态、产线和时刻的唯一有效规则"
          },
          "snapshot_at": {
            "type": "string",
            "format": "date-time",
            "title": "Snapshot At",
            "description": "MES 服务端本次只读事务快照时刻"
          }
        },
        "type": "object",
        "required": [
          "heat",
          "process_stage",
          "scope",
          "stage_started_at",
          "temperature",
          "chemistry",
          "rule",
          "snapshot_at"
        ],
        "title": "AnalysisContext"
      },
      "Chemistry": {
        "properties": {
          "heat_id": {
            "type": "string",
            "title": "Heat Id",
            "description": "MES 炉次号，动态业务标识；不是合法 ID 白名单"
          },
          "carbon_pct": {
            "type": "number",
            "title": "Carbon Pct",
            "description": "碳质量百分比，0.18 表示 0.18%；不包含合格范围"
          },
          "silicon_pct": {
            "type": "number",
            "title": "Silicon Pct",
            "description": "硅质量百分比，0.25 表示 0.25%；不包含合格范围"
          },
          "manganese_pct": {
            "type": "number",
            "title": "Manganese Pct",
            "description": "锰质量百分比，0.65 表示 0.65%；不包含合格范围"
          },
          "measured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Measured At",
            "description": "源系统记录的测量时间；不代表本次查询时间"
          }
        },
        "type": "object",
        "required": [
          "heat_id",
          "carbon_pct",
          "silicon_pct",
          "manganese_pct",
          "measured_at"
        ],
        "title": "Chemistry"
      },
      "ErrorDetail": {
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "request",
              "data",
              "system"
            ],
            "title": "Category",
            "description": "request：请求错误；data：事实不存在或数据不可用；system：系统失败、事实状态未知"
          },
          "code": {
            "type": "string",
            "title": "Code",
            "description": "稳定机器错误码，与 HTTP 状态及 category 一起判断；见各响应示例"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "可读错误提示，调用方不要依赖提示文本进行逻辑分支"
          },
          "fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Fields",
            "description": "相关字段路径；参数错误如 path.heat_id，数据错误如 temperature_c；无字段级信息时为空数组"
          }
        },
        "type": "object",
        "required": [
          "category",
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail",
            "description": "统一错误对象；不包含工艺判定或生产处置建议"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "全部 Mock 系统数据库可读时为 ok"
          },
          "backends": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Backends",
            "description": "SQLite 模拟后端连通状态"
          }
        },
        "type": "object",
        "required": [
          "status",
          "backends"
        ],
        "title": "HealthResponse"
      },
      "Heat": {
        "properties": {
          "heat_id": {
            "type": "string",
            "title": "Heat Id",
            "description": "MES 炉次号，动态业务标识；不是合法 ID 白名单"
          },
          "steel_grade": {
            "type": "string",
            "title": "Steel Grade",
            "description": "MES 记录的钢种；不包含该钢种的工艺标准"
          },
          "status": {
