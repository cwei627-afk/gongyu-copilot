            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "verified"
                          ]
                        },
                        "facts": {
                          "$ref": "#/components/schemas/HeatTaskLink",
                          "description": "业务系统结构化事实，不是文档 citation"
                        },
                        "verified_claims": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "claim_id": {
                                "type": "string"
                              },
                              "text": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "claim_id",
                              "text"
                            ]
                          }
                        },
                        "output_schema": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "status",
                        "facts",
                        "verified_claims",
                        "output_schema"
                      ]
                    },
                    {
                      "$ref": "#/components/schemas/AgentToolFailure"
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "请求能力无效/过期；不是工艺异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentToolFailure"
                }
              }
            }
          },
          "422": {
            "description": "request / INVALID_PARAMETER：路径参数格式非法，未查询业务系统。",
            "content": {
              "application/json": {
                "examples": {
                  "invalid_parameter": {
                    "value": {
                      "error": {
                        "category": "request",
                        "code": "INVALID_PARAMETER",
                        "message": "请求参数格式非法",
                        "fields": [
                          "path.heat_id"
                        ]
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "system / INTERNAL_ERROR：内部系统失败，事实状态未知，不得推断生产异常。",
            "content": {
              "application/json": {
                "examples": {
                  "internal_error": {
                    "value": {
                      "error": {
                        "category": "system",
                        "code": "INTERNAL_ERROR",
                        "message": "内部系统失败，事实状态未知",
                        "fields": []
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
