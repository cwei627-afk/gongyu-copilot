# Server-side configuration only. Never copy secrets into frontend/VITE_* values.
COPILOT_BASE_URL=http://127.0.0.1:18095
COPILOT_SOURCE_BASE=http://127.0.0.1:18090
DIFY_BASE_URL=http://localhost
DIFY_C_API_KEY=<server-side-published-app-key>
DIFY_D_API_KEY=<server-side-published-app-key>
DIFY_E1_API_KEY=<server-side-published-app-key>
DIFY_F_INTERNAL_API_KEY=<server-side-published-app-key>
DIFY_F_PUBLIC_API_KEY=<server-side-published-app-key>
DIFY_F_ROUTER_API_KEY=<server-side-published-app-key>

# F2 desktop knowledge keys belong in .env.stage-f2.local (server only).
# The old F keys remain for compatibility tests; F2 does not silently fall back.
DIFY_F2_INTERNAL_API_KEY=<server-side-f2-internal-published-app-key>
DIFY_F2_PUBLIC_API_KEY=<server-side-f2-public-published-app-key>
